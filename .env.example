# Copy to .env for local Docker use; never commit credentials.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=0
NOTIFICATION_EMAIL_ENABLED=0
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
# Optional PostgreSQL URL; omit to use local persistent SQLite.
DATABASE_URL=
NOTIFICATION_EMAIL_RECIPIENTS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=
APP_BASE_URL=http://127.0.0.1:8000
