# Public demo only. Use an empty, dedicated deployment volume.
APP_DOMAIN=desk.example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
NOTIFICATION_EMAIL_ENABLED=0
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
# Required when enabling email on the public demo; comma-separated approved addresses.
NOTIFICATION_EMAIL_RECIPIENTS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=
